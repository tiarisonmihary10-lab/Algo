Algorithme CalculSimple
Variable
  var a: ENTIER <- 10;
  var b: ENTIER <- 3;
  var resultatReel: REEL;
  var resultatEntier: ENTIER;

debut
  
  resultatEntier <- a + b; 
  afficher("a + b = ", resultatEntier);

  
  resultatEntier <- a - b;  
  afficher("a - b = ", resultatEntier);

  
  resultatEntier <- a * b; 
  afficher("a * b = ", resultatEntier);

  
  resultatReel <- a / b;  
  afficher("a / b = ", resultatReel);

  
  resultatEntier <- a div b; 
  afficher("a div b = ", resultatEntier);
fin